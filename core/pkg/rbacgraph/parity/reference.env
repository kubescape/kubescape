# The Kubernetes reference the RBAC parity fixtures are verified against.
#
# This file is the single place the reference version is written down. It is
# sourced by fetch-reference.sh, which downloads the binaries, and parsed by
# the tests, which refuse to run against any other server version.
#
# KUBE_APISERVER_VERSION must stay on the Kubernetes minor of the k8s.io/api
# module in go.mod (v0.37.x <-> v1.37.x); TestReferenceTracksGoMod fails when
# it does not. ETCD_VERSION is the etcd release that Kubernetes version itself
# pins (build/dependencies.yaml in kubernetes/kubernetes).
#
# To move the reference: change the versions, replace the checksums with the
# published ones, run the reference tests, and correct any fixture whose
# recorded answer the new server no longer gives.
#   kube-apiserver: https://dl.k8s.io/<version>/bin/linux/<arch>/kube-apiserver.sha256
#   etcd:           https://github.com/etcd-io/etcd/releases/download/<version>/SHA256SUMS
KUBE_APISERVER_VERSION=v1.37.1
KUBE_APISERVER_SHA256_LINUX_AMD64=de9b1b43c10143f448408b3aaf15f44fd5248b97a56301417a1fe2f1fc47a691
KUBE_APISERVER_SHA256_LINUX_ARM64=c3c240bc4a0fbe3ad311ac3d74ca1d19ac411628130ea825049550fd856020d9
ETCD_VERSION=v3.7.0
ETCD_SHA256_LINUX_AMD64=b05cb07f5686dab8f9cdab89986b44f0dd24aaf5c627176aff325e21fa56f9f0
ETCD_SHA256_LINUX_ARM64=e61a0954fe6a3003ee20f45e773e12e15c58323ea485deb8a55d065170cdafe8
